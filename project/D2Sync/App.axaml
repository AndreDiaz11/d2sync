<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="D2Sync.App"
             xmlns:local="using:D2Sync"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.titlebar-btn">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.titlebar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#30FFFFFF" />
        </Style>
        <Style Selector="Button.titlebar-btn.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B2DC3232" />
        </Style>

        <Style Selector="Button.grad-btn">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#5AE4FF" Offset="0" />
                    <GradientStop Color="#1890D8" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.grad-btn:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <Style Selector="Button.pill-ghost">
            <Setter Property="Background" Value="#26000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="50" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.pill-ghost:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </Application.Styles>
</Application>
