<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D2Sync.Views.AccountPickerWindow"
        Width="360" Height="420"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="BorderOnly"
        Background="#1A1F38"
        Title="Seleccionar cuenta">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" Padding="20,16,12,14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="HeaderText" Text="Seleccionar cuenta" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕" Click="CloseClick" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,4" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="ItemsPanel" Margin="0,8" />
        </ScrollViewer>
    </Grid>
</Window>
