<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:D2Sync.ViewModels"
             x:Class="D2Sync.Views.BottomBarView"
             x:DataType="vm:MainWindowViewModel">
    <Border Padding="32,12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#26000000" Offset="0" />
                <GradientStop Color="#4D000000" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="🎮" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Estado}" FontSize="12.5" Foreground="#B0C4E8" TextTrimming="CharacterEllipsis" />
                    <ProgressBar IsIndeterminate="True" Width="12" Height="12" IsVisible="{Binding Busy}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="pill-ghost" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Busy}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="↻" FontSize="12" />
                        <TextBlock Text="{Binding RefreshLabel}" />
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <TextBlock Text="{Binding VersionLine}" FontSize="10.5" Foreground="#3DFFFFFF" />
                <Button Content="{Binding UpdateLinkText}" Command="{Binding RequestUpdateCommand}" IsVisible="{Binding HasUpdateLink}"
                        Background="Transparent" BorderThickness="0" Padding="0" FontSize="10.5" FontWeight="Bold" Foreground="#5AE4FF" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
