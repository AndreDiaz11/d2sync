<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:D2Sync.ViewModels"
             xmlns:local="using:D2Sync.Views"
             x:Class="D2Sync.Views.OptimizedSectionView"
             x:DataType="vm:OptimizedSectionViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="{Binding OptimizeAccountLabel}" FontSize="12.5" Foreground="#99FFFFFF" Margin="4,0,0,0" />
            <Button Command="{Binding PickCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="#1A1F38" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14" Padding="18,16">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="●" FontSize="12" Foreground="#E8924E" />
                    <TextBlock Text="{Binding Seleccion.NombreVisible, FallbackValue='— Sin elección —'}" FontSize="13.5" Foreground="White" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" IsVisible="{Binding Seleccion, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#1F1A1F38" CornerRadius="14" Padding="16" Margin="0,14,0,14">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding StatusIcon}" FontSize="16" Foreground="{Binding StatusColor}" />
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding StatusTitle}" FontSize="13.5" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding StatusSub}" FontSize="12" Foreground="#B0C4E8" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,0,0,14">
            <ItemsControl ItemsSource="{Binding Opciones}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OptimizationOptionViewModel">
                        <Border Background="{Binding IsChecked, Converter={x:Static local:CheckedBgConverter.Instance}}"
                                BorderBrush="{Binding IsChecked, Converter={x:Static local:CheckedBorderConverter.Instance}}"
                                BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#B0C4E8" TextWrapping="Wrap" Width="480" LineHeight="16" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnDefinitions="*,14,*">
            <Button Grid.Column="0" Classes="grad-btn" Content="{Binding CheckLabel}" Command="{Binding CheckCommand}" IsEnabled="{Binding Seleccion, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Grid.Column="2" Classes="grad-btn" Content="{Binding OptimizeLabel}" Command="{Binding OptimizeCommand}" IsEnabled="{Binding Verificado}" />
        </Grid>
    </Grid>
</UserControl>
