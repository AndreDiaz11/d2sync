<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:D2Sync.ViewModels"
             x:Class="D2Sync.Views.DeleteSectionView"
             x:DataType="vm:DeleteSectionViewModel">
    <ScrollViewer>
        <StackPanel Spacing="14">
            <StackPanel Spacing="5">
                <TextBlock Text="{Binding DeleteAccountLabel}" FontSize="12.5" Foreground="#99FFFFFF" Margin="4,0,0,0" />
                <Button Command="{Binding PickCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="#1A1F38" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14" Padding="18,16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="●" FontSize="12" Foreground="#FF6B6B" />
                        <TextBlock Text="{Binding Seleccion.NombreVisible, FallbackValue='— Sin elección —'}" FontSize="13.5" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border IsVisible="{Binding Seleccion, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#1FFF6B6B" CornerRadius="14" Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="⚠" FontSize="18" Foreground="#FF6B6B" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding WillDeleteText}" FontSize="13.5" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding DeleteWarningSub}" FontSize="12" Foreground="#B0C4E8" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,14,*">
                <Button Grid.Column="0" Classes="grad-btn" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" IsEnabled="{Binding Seleccion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Grid.Column="2" Classes="grad-btn" Content="{Binding DeleteAndRemoveLabel}" Command="{Binding DeleteAndRemoveCommand}" IsEnabled="{Binding Seleccion, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
