<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:D2Sync.ViewModels"
             x:Class="D2Sync.Views.SyncSectionView"
             x:DataType="vm:SyncSectionViewModel">
    <ScrollViewer>
        <StackPanel Spacing="14">
            <StackPanel Spacing="5">
                <TextBlock Text="{Binding SyncSourceLabel}" FontSize="12.5" Foreground="#99FFFFFF" Margin="4,0,0,0" />
                <Button Command="{Binding PickOrigenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="#1A1F38" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14" Padding="18,16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="●" FontSize="12" Foreground="#5B9BD5" />
                        <TextBlock Text="{Binding Origen.NombreVisible, FallbackValue='— Sin elección —'}" FontSize="13.5" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Spacing="5">
                <TextBlock Text="{Binding SyncTargetLabel}" FontSize="12.5" Foreground="#99FFFFFF" Margin="4,0,0,0" />
                <Button Command="{Binding PickDestinoCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="#1A1F38" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14" Padding="18,16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="●" FontSize="12" Foreground="#E8924E" />
                        <TextBlock Text="{Binding Destino.NombreVisible, FallbackValue='— Sin elección —'}" FontSize="13.5" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border IsVisible="{Binding TieneAlgo}" Background="#1F1A1F38" CornerRadius="14" Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding StatusIcon}" FontSize="18" Foreground="{Binding StatusColor}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding StatusTitle}" FontSize="13.5" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding StatusSub}" FontSize="12" Foreground="#B0C4E8" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Classes="grad-btn" Content="{Binding SyncButtonLabel}" Command="{Binding SyncCommand}" IsEnabled="{Binding Listos}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
